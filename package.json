{
  "name": "texcra",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "generate-routes": "tsr generate",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint",
    "format": "prettier --write . && eslint --fix",
    "check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:export": "bash scripts/export-schema.sh",
    "db:migrate:local": "wrangler d1 migrations apply texcra-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply texcra-db",
    "db:seed:local": "wrangler d1 execute texcra-db --local --file=./scripts/seed.sql",
    "test:db": "tsx scripts/verify-db.ts",
    "paraglide": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide --emit-ts-declarations --strategy url baseLocale",
    "paraglide:watch": "npm run paraglide -- --watch"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-sans-condensed": "^5.3.0",
    "@inlang/paraglide-js-react": "^1.0.3",
    "@lexical/html": "^0.52.0",
    "@lexical/link": "^0.52.0",
    "@lexical/list": "^0.52.0",
    "@lexical/markdown": "^0.52.0",
    "@lexical/react": "^0.52.0",
    "@lexical/rich-text": "^0.52.0",
    "@lexical/selection": "^0.52.0",
    "@lexical/utils": "^0.52.0",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@react-three/postprocessing": "^3.1.1",
    "@reduxjs/toolkit": "^2.12.0",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-devtools": "latest",
    "@tanstack/react-router": "latest",
    "@tanstack/react-router-devtools": "latest",
    "@tanstack/react-start": "latest",
    "@types/three": "^0.185.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.2.5",
    "dotenv": "^18.0.5",
    "drizzle-orm": "1.0.0-rc.4",
    "gsap": "^3.15.0",
    "lexical": "^0.52.0",
    "lucide-react": "^1.41.0",
    "nitro": "3.0.260610-beta",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-redux": "^9.3.0",
    "react-select": "^5.10.2",
    "react-select-async-paginate": "^0.7.11",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4.1.18",
    "three": "^0.185.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@dbml/cli": "^10.2.0",
    "@dbml/core": "^10.2.0",
    "@inlang/paraglide-js": "^2.13.1",
    "@tanstack/devtools-vite": "latest",
    "@tanstack/eslint-config": "latest",
    "@tanstack/router-cli": "^1.132.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "drizzle-dbml-generator": "^0.10.0",
    "drizzle-kit": "1.0.0-rc.4",
    "eslint": "^9.20.0",
    "prettier": "^3.8.1",
    "prettier-plugin-toml": "^3.0.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "wrangler": "^4.147.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  }
}
