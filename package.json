{
  "name": "texcra",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm run worker:dev",
    "build": "pnpm run worker:build",
    "lint": "eslint .",
    "format": "prettier --write . && eslint --fix .",
    "check": "prettier --check .",
    "typecheck": "pnpm -r run typecheck",
    "worker:dev": "pnpm --filter worker run dev",
    "worker:types": "pnpm --filter worker types",
    "worker:generate-routes": "pnpm --filter worker run generate-routes",
    "worker:build": "pnpm --filter worker run build",
    "worker:preview": "pnpm --filter worker run preview",
    "worker:lint": "pnpm --filter worker run lint",
    "worker:format": "pnpm --filter worker run format",
    "worker:check": "pnpm --filter worker run check",
    "worker:typecheck": "pnpm --filter worker run typecheck",
    "worker:db:generate": "pnpm --filter worker run db:generate",
    "worker:db:export": "pnpm --filter worker run db:export",
    "worker:db:migrate:local": "pnpm --filter worker run db:migrate:local",
    "worker:db:migrate:remote": "pnpm --filter worker run db:migrate:remote",
    "worker:db:seed:local": "pnpm --filter worker run db:seed:local",
    "worker:test:db": "pnpm --filter worker run test:db",
    "worker:smoke:upload": "pnpm --filter worker run smoke:upload",
    "worker:paraglide": "pnpm --filter worker run paraglide",
    "worker:paraglide:watch": "pnpm --filter worker run paraglide:watch",
    "shared:typecheck": "pnpm --filter shared run typecheck"
  },
  "devDependencies": {
    "bun": "1.4.3",
    "@tanstack/eslint-config": "latest",
    "eslint": "^9.20.0",
    "prettier": "^3.8.1",
    "prettier-plugin-toml": "^3.0.2",
    "typescript": "^6.0.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  }
}
